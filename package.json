{
  "name": "theology-mbti-2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "check:data": "node scripts/validate-data.mjs",
    "test:browser": "playwright test",
    "check": "npm run check:data && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
