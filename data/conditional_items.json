[
  {
    "id": "F01",
    "domain": "신론",
    "prompt": "하나님을 한 분으로 고백할 때 무엇을 의미하는가?",
    "selection_mode": "single",
    "choices": [
      {
        "id": "F01-1",
        "text": "하나의 신적 본질 안에 실제로 구별되는 성부·성자·성령이 계신다."
      },
      {
        "id": "F01-2",
        "text": "성부·성자·성령은 한 인격의 서로 다른 표현이다."
      },
      {
        "id": "F01-3",
        "text": "성부는 한 분의 유일한 하나님이시고 성자는 최초의 피조물이다."
      },
      {
        "id": "F01-4",
        "text": "세 위격은 각각 독립된 신이다."
      },
      {
        "id": "F01-5",
        "text": "이 교리의 의미를 아직 제대로 이해하지 못했다."
      }
    ],
    "source_ids": [
      "NICENE381",
      "CCC_TRINITY"
    ],
    "review_status": "needs_subject_matter_review",
    "optional": true,
    "allow_unknown": true
  },
  {
    "id": "F02",
    "domain": "신론",
    "prompt": "하나님의 섭리와 인간의 선택에 관하여 함께 긍정하는 내용을 골라 주세요.",
    "selection_mode": "multi",
    "choices": [
      {
        "id": "F02-1",
        "text": "하나님은 모든 일에 궁극적인 주권을 가지신다."
      },
      {
        "id": "F02-2",
        "text": "인간의 선택에는 다른 선택을 할 실제 가능성이 존재한다."
      },
      {
        "id": "F02-3",
        "text": "하나님은 다양한 조건에서 인간이 자유롭게 내릴 결정을 아신다."
      },
      {
        "id": "F02-4",
        "text": "아직 결정되지 않은 자유로운 미래는 열린 가능성으로 남아 있다."
      },
      {
        "id": "F02-5",
        "text": "하나님이 모든 일을 작정하셨지만 인간에게도 책임이 있다."
      }
    ],
    "source_ids": [
      "WCF",
      "METHODIST_ART"
    ],
    "review_status": "needs_subject_matter_review",
    "optional": true,
    "allow_unknown": true
  },
  {
    "id": "F03",
    "domain": "인간론",
    "prompt": "죄인의 믿음과 거듭남의 순서를 가장 가깝게 설명한다면?",
    "selection_mode": "single",
    "choices": [
      {
        "id": "F03-1",
        "text": "하나님이 거듭나게 하시기에 믿음이 생겨난다."
      },
      {
        "id": "F03-2",
        "text": "하나님의 은혜가 먼저 역사하고 인간은 믿음으로 협력한다."
      },
      {
        "id": "F03-3",
        "text": "하나님의 선행은총이 믿음으로 응답할 능력을 회복한다."
      },
      {
        "id": "F03-4",
        "text": "인간은 특별한 선행은총이 없어도 본래적 능력으로 믿음을 시작할 수 있다."
      },
      {
        "id": "F03-5",
        "text": "순서를 교리적으로 규정하기 어렵다."
      }
    ],
    "source_ids": [
      "WCF",
      "METHODIST_ART",
      "NAZ_ART"
    ],
    "review_status": "needs_subject_matter_review",
    "optional": true,
    "allow_unknown": true
  },
  {
